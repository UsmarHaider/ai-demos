# ===================================================================
#  Copy this file to .env, then paste your own key in.
#
#      cp .env.example .env
#
#  .env is listed in .gitignore and is never committed. Get a free
#  Gemini key from https://aistudio.google.com/apikey
# ===================================================================

# ---------------------------------------------------- the only key needed
# Used for both chat and embeddings.
GOOGLE_API_KEY=paste-your-gemini-key-here

# ---------------------------------------------------------------- chat
# Which Gemini model answers questions and drives the agent.
# gemini-3.5-flash-lite has the most generous free-tier limits.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------- embeddings
# "gemini" uses the real embedding model below.
# "local"  switches to a no-network numpy keyword embedding instead -
#          lower quality, but it needs no key and has no quota at all.
EMBED_BACKEND=gemini
EMBED_MODEL=models/gemini-embedding-001
